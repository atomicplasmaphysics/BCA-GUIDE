#
#sum(STOPS)    ..stops of generated not sputtered recoils + stops of incident projectiles
#sum(STOPS)=sum(DISPL) - BACKW.SPUTTER.RECOILS(output.dat) + IMPLANTED_PROJ
#sum(STOPS<ED) ..stops of generated not sputtered recoils with E<=Ed       
#sum(DISPL)    ..damages of generated recoils (start point of recoil)      
#sum(DISPL<ED) ..damages of generated recoils with E<=Ed                   
#repl..replacement generated recoils E(Z1)<Ed(Z1) & E(Z2)>Ed(Z2)  & Z1 =Z2 
#subs..subtitution generated recoils E(Z1)<Ed(Z1) & E(Z2)>Ed(Z2)  & Z1/=Z2 
 
 
#Calculated Values:                      
#  STOPS>Ed      =STOPS-STOPS<ED         
#  DISPL_fictive=STOPS<ED                
#  DISPL_real   =DISPL - STOPS           
#  DISPL>Ed     =DISPL - DISPL<ED        
#  VACANCIES    =DISPL - STOPS(depth_recoil.dat) + STOPS>Ed(depth_recoil.dat) - REPL - SUBS
#  VACANCIES    =DISPL - STOPS<Ed(depth_recoil.dat)                           - REPL - SUBS
#  d_ATOMS     = STOPS - DISPL           
#  sum(STOPS)  = sum(DISPL) - BACKW.SPUTTER.REC.(output.dat) + IMPLANTED_PROJ.(output.dat) 
#
 Ar        
#  BACKW._SPUTTER.REC      =DISPL    - STOPS    (see output.dat)                  0
#  BACKW._SPUTTER.REC.(<ED)=DISPL<Ed - STOPS<Ed (see output.dat)                  0
#  BACKW._SPUTTER.REC.(>ED)=DISPL>Ed - STOPS>Ed (see output.dat)                  0
 
