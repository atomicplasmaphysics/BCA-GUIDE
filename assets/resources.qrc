<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/assets">
        <file>aboutlogo_iap.png</file>
        <file>aboutlogo_ipp.png</file>
        <file>aboutlogo_hzdr.png</file>
        <file>tu_logo.png</file>
        <file>tu_logo_loco.png</file>
        <file>splash.png</file>
        <file>clouds.png</file>
    </qresource>
</RCC>

<!--
Images of the window, the about dialog and the splash screen, used as ":/assets/<name>".
The icons of buttons and actions are svg icons in Utility/Icons.py and do not need to be listed here.

Create the corresponding assets/resources.py file by running
$ python setup/build_resources.py
This is necessary when a resource has been added or modified.
Requires: pip install pyside6 (only for building, the generated resources.py only depends on PyQt6)
-->
